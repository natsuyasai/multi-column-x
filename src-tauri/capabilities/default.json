{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "store:default",
    "notification:default",
    "allow-load-settings",
    "allow-save-settings",
    "allow-create-column-webview",
    "allow-get-external-column-data-directory",
    "allow-remove-column-webview",
    "allow-resize-column-webview",
    "allow-open-link-popup-window",
    "allow-eval-in-webview",
    "allow-get-mobile-insets",
    "allow-set-column-cookies",
    "allow-is-webview-profile-supported",
    "allow-update-mobile-swipe-bar",
    "allow-flash-mobile-swipe-bar",
    "allow-open-add-account-window",
    "allow-reauth-account-window",
    "allow-delete-account-data",
    "allow-close-window",
    "allow-open-compose-window",
    "allow-install-apk-update",
    "allow-check-media-codec-support",
    "allow-download-and-enable-h264"
  ]
}
